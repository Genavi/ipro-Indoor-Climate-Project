      "targets": [
        {
          "datasource": {
            "type": "postgres",
            "uid": "${DS_POSTGRESQL}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH latest_readings AS (\n  SELECT DISTINCT ON (sensor_type)\n    sensor_type,\n    value\n  FROM sensor_readings\n  WHERE\n    time > NOW() - INTERVAL '2 minutes'\n    AND reader IN ($reader_query)\n    AND location IN ($location_query)\n  ORDER BY sensor_type, time DESC\n),\nscores AS (\n  SELECT\n    CASE \n      WHEN sensor_type = 'co2' THEN\n        CASE\n          WHEN value < 600 THEN 100\n          WHEN value < 800 THEN 90\n          WHEN value < 1000 THEN 70\n          WHEN value < 1500 THEN 40\n          ELSE 20\n        END\n      WHEN sensor_type = 'humidity' THEN\n        CASE\n          WHEN value BETWEEN 30 AND 50 THEN 100\n          WHEN value BETWEEN 25 AND 60 THEN 80\n          WHEN value BETWEEN 20 AND 70 THEN 50\n          ELSE 30\n        END\n      WHEN sensor_type = 'temperature' THEN\n        CASE\n          WHEN value BETWEEN 18 AND 23 THEN 100\n          WHEN value BETWEEN 16 AND 26 THEN 80\n          WHEN value BETWEEN 14 AND 28 THEN 50\n          ELSE 30\n        END\n      WHEN sensor_type = 'light' THEN\n        CASE\n          WHEN value > 30 THEN 100\n          WHEN value > 15 THEN 85\n          ELSE 60\n        END\n    END as score\n  FROM latest_readings\n)\nSELECT ROUND(AVG(score)) FROM scores;",
          "refId": "A"
        }
      ],
      "title": "",
      "type": "stat"
    },
